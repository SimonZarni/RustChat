# Every `server` replica is found through Docker DNS (re-resolved every few
# seconds), so `docker compose up --scale server=N` needs no other change.
# Realtime events are shared between replicas through PostgreSQL, so
# WebSockets do not need sticky routing.
(replicas) {
	reverse_proxy {
		dynamic a {
			name server
			port 8080
			refresh 5s
		}
		lb_policy least_conn
		lb_try_duration 3s
	}
}

{$RUSTCHAT_DOMAIN:localhost} {
	encode zstd gzip
	handle /api/* {
		import replicas
	}
	handle /healthz {
		import replicas
	}
	handle /readyz {
		import replicas
	}
	handle /metrics* {
		respond 404
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
