{$RUSTCHAT_DOMAIN:localhost} {
	encode zstd gzip
	handle /api/* {
		reverse_proxy server:8080
	}
	handle /healthz {
		reverse_proxy server:8080
	}
	handle /readyz {
		reverse_proxy server:8080
	}
	handle /metrics* {
		respond 404
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
