# Copy to deployment/.env (git-ignored) and replace every placeholder.
# Use URL-safe random values (letters, digits, _ and -), at least 32 chars.
POSTGRES_PASSWORD=replace-with-long-random-admin-password
APP_DB_PASSWORD=replace-with-a-different-long-random-app-password
MIGRATOR_DB_PASSWORD=replace-with-a-different-long-random-migration-password
RUSTCHAT_DOMAIN=chat.example.com
RUSTCHAT_SERVER_IMAGE=rustchat/server:replace-with-release-tag
RUSTCHAT_WEB_IMAGE=rustchat/web:replace-with-release-tag
RUSTCHAT_DB_MAX_CONNECTIONS=10
RUSTCHAT_GROUP_MEMBER_LIMIT=100
RUSTCHAT_ATTACHMENT_MAX_MIB=25
RUSTCHAT_ATTACHMENT_QUOTA_GIB=2
RUSTCHAT_SESSION_IDLE_TIMEOUT_DAYS=7
# Optional two-step verification. Generate with: openssl rand -hex 32
# Keep this value secret and back it up separately from database backups.
RUSTCHAT_MFA_ENCRYPTION_KEY=
RUSTCHAT_MFA_ISSUER=RustChat
RUSTCHAT_LOGIN_PER_IP_LIMIT=30
RUSTCHAT_LOGIN_PER_USERNAME_LIMIT=10
RUSTCHAT_REGISTER_PER_IP_LIMIT=5
RUSTCHAT_API_READ_LIMIT=600
RUSTCHAT_API_WRITE_LIMIT=120
RUSTCHAT_MESSAGE_SEND_LIMIT=60
RUSTCHAT_CREATE_LIMIT=30
RUSTCHAT_UNAUTHENTICATED_LIMIT=120
RUSTCHAT_ADMIN_USER_IDS=

# Optional S3-compatible object storage (Garage is the selected self-hosted backend).
# The endpoint must be browser-reachable for signed direct uploads and use HTTPS
# when RUSTCHAT_COOKIE_SECURE=true. Leave all values empty to disable attachments.
RUSTCHAT_S3_ENDPOINT=
RUSTCHAT_S3_REGION=
RUSTCHAT_S3_BUCKET=
RUSTCHAT_S3_ACCESS_KEY_ID=
RUSTCHAT_S3_SECRET_ACCESS_KEY=

# Optional password recovery email delivery (implicit TLS, normally port 465).
# Leave all values empty to disable recovery email.
RUSTCHAT_PUBLIC_URL=
RUSTCHAT_SMTP_HOST=
RUSTCHAT_SMTP_PORT=465
RUSTCHAT_SMTP_USERNAME=
RUSTCHAT_SMTP_PASSWORD=
RUSTCHAT_EMAIL_FROM=
RUSTCHAT_WEB_PUSH_VAPID_PUBLIC_KEY=
RUSTCHAT_WEB_PUSH_VAPID_PRIVATE_KEY_PEM=
RUSTCHAT_WEB_PUSH_SUBJECT=
RUSTCHAT_LIVEKIT_URL=
RUSTCHAT_LIVEKIT_API_KEY=
RUSTCHAT_LIVEKIT_API_SECRET=
